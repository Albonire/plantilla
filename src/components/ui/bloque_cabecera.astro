---
// header of an activity block written in Astro (same look as Superficie in the React islands):
// a pill with the verb ("Mira", "Escucha"...), the small label and the title
import {
  BookOpenText,
  ChatsCircle,
  Flag,
  Globe,
  Headphones,
  MonitorPlay,
  PencilSimpleLine,
  PuzzlePiece,
} from '@phosphor-icons/react/ssr';
import { bloques, clase_pastilla, type TipoBloque } from '../../lib/bloques';

interface Props {
  tipo?: TipoBloque;
  etiqueta?: string;
  titulo: string;
  id_titulo?: string;
}
const { tipo, etiqueta, titulo, id_titulo } = Astro.props;

const iconos = {
  lee: BookOpenText,
  mira: MonitorPlay,
  escucha: Headphones,
  practica: PuzzlePiece,
  escribe: PencilSimpleLine,
  conversa: ChatsCircle,
  web: Globe,
  reto: Flag,
};
const Icono = tipo ? iconos[tipo] : null;
---

<header class="mb-5 md:mb-6">
  {(tipo || etiqueta) && (
    <p class="interfaz flex flex-wrap items-center gap-x-3 gap-y-1 text-body-sm font-medium text-stone-text">
      {tipo && Icono && (
        <span class:list={[clase_pastilla, bloques[tipo].fondo]}>
          <Icono size={18} weight="bold" aria-hidden="true" />
          {bloques[tipo].verbo}
        </span>
      )}
      {etiqueta && <span>{etiqueta}</span>}
    </p>
  )}
  <h3 id={id_titulo} class="mt-3 text-[1.375rem] leading-snug md:text-[1.625rem]">
    {titulo}
  </h3>
</header>
