---
// chapter opening of a case: big number, title and an illustration in three paper layers.
// It is the header of the first page of the case (no pin, no parallax).
import { folio, pagina_por_slug } from '../../config/paginas';

interface Props {
  numero: number;
  titulo: string;
  color: 'fresh-grass' | 'sky-pop' | 'sunshine-pop' | 'coral-pop' | 'mixto';
  alt: string;
}
const { numero, titulo, color, alt } = Astro.props;

const fondos: Record<Props['color'], string> = {
  'fresh-grass': 'bg-fresh-grass',
  'sky-pop': 'bg-sky-pop',
  'sunshine-pop': 'bg-sunshine-pop',
  'coral-pop': 'bg-coral-pop',
  mixto: 'bg-fresh-grass',
};
const numero_texto = String(numero).padStart(2, '0');
const primera = pagina_por_slug('abrir');
---

<section id="portada" aria-labelledby="portada-titulo" class="contenedor pt-6 md:pt-10">
  <div
    class:list={[
      'relative isolate grid overflow-hidden rounded-soft border-2 border-ink-black text-ink-black md:grid-cols-2',
      fondos[color],
    ]}
  >
    {color === 'mixto' && (
      <div class="absolute inset-x-0 bottom-0 -z-10 h-1/3 bg-sunshine-pop" aria-hidden="true"></div>
    )}

    <div
      class="relative aspect-[5/4] md:order-last md:aspect-auto md:min-h-[22rem]"
      role="img"
      aria-label={alt}
    >
      <div class="absolute inset-0" aria-hidden="true">
        <slot name="fondo" />
      </div>
      <div class="absolute inset-0" aria-hidden="true">
        <slot name="medio" />
      </div>
      <div class="absolute inset-0" aria-hidden="true">
        <slot name="frente" />
      </div>
    </div>

    <div class="relative z-10 flex flex-col justify-end p-6 md:p-10">
      <p class="text-body font-medium">Caso {numero}</p>
      <p
        aria-hidden="true"
        class="-ml-0.5 mt-1 text-[clamp(4rem,2rem+8vw,7rem)] leading-[0.9] font-medium tracking-tighter"
      >
        {numero_texto}
      </p>
      <h1
        id="portada-titulo"
        class="mt-3 max-w-[16ch] text-heading font-medium leading-tight tracking-tight"
      >
        {titulo}
      </h1>
      <p class="mt-5 text-body-sm font-medium">
        {primera?.titulo} · {folio('abrir')}
      </p>
    </div>
  </div>
</section>
