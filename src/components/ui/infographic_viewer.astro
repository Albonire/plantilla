---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { MagnifyingGlassPlus, DownloadSimple, X } from '@phosphor-icons/react/ssr';
import multimedia from '../../data/multimedia.json';
import AiLabel from './ai_label.astro';

interface Props {
  id: string;
  titulo?: string;
}
const { id, titulo = 'El caso en una imagen' } = Astro.props;

const pieza = multimedia.find((m) => m.id === id);
if (!pieza || pieza.tipo !== 'infografia') throw new Error(`infografía no encontrada: ${id}`);

const imagenes = import.meta.glob<{ default: ImageMetadata }>('../../assets/infografias/*.png', {
  eager: true,
});
const ruta = `../../assets/infografias/${pieza.archivo}`;
const origen = imagenes[ruta]?.default;
if (!origen) throw new Error(`falta la imagen de la infografía: ${pieza.archivo}`);

const grande = await getImage({
  src: origen,
  format: 'webp',
  width: Math.min(origen.width, 1800),
  quality: 82,
});
// widths up to the original size (never upscaled)
const anchos = [...[480, 720, 1000, 1400, 2000].filter((w) => w < origen.width), origen.width];
const nombre_descarga = pieza.archivo.replace('.png', '.webp');
const focos = ((pieza as { focos?: Foco[] }).focos ?? []) as Foco[];
import BloqueCabecera from './bloque_cabecera.astro';
import CamaraVinetas from '../libro/camara_vinetas.astro';

interface Foco {
  id: string;
  x: number;
  y: number;
  w: number;
  h: number;
  titulo: string;
  texto: string;
}
---

<section
  aria-labelledby={`${id}-titulo`}
  class="rounded-card border-2 border-ink-black bg-pure-white p-5 text-ink-black md:p-8"
  data-infografia
>
  <BloqueCabecera tipo="mira" etiqueta={titulo} titulo={pieza.titulo} id_titulo={`${id}-titulo`} />
  <p class="mb-5 max-w-reading text-body">
    Baja despacio: la cámara recorre la imagen parte por parte. Cada parte trae su texto debajo de
    la imagen para que puedas leerlo tranquilo.
  </p>

  <CamaraVinetas
    id={`${id}-camara`}
    titulo={pieza.titulo}
    ratio={origen.width / origen.height}
    focos={focos}
    etiqueta_paso="Parte"
    nitida
  >
    <Picture
      src={origen}
      alt={pieza.alt}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={anchos}
      sizes="(min-width: 1024px) 44rem, 92vw"
      quality={78}
      loading="lazy"
      decoding="async"
      class="block h-full w-full object-cover"
      style={`background:${pieza.fondo}`}
    />
  </CamaraVinetas>

  <div class="mt-6 flex flex-wrap items-center gap-3">
    <button
      type="button"
      data-abrir
      aria-haspopup="dialog"
      class="interfaz inline-flex min-h-11 items-center gap-2.5 rounded-pill border-2 border-ink-black bg-pure-white px-5 text-body-sm font-medium hover:bg-sandstone"
    >
      <MagnifyingGlassPlus size={20} weight="bold" aria-hidden="true" />
      Ampliar la imagen
    </button>
    <a
      href={grande.src}
      download={nombre_descarga}
      class="interfaz inline-flex min-h-11 items-center gap-2.5 rounded-pill border-2 border-ink-black bg-pure-white px-5 text-body-sm font-medium hover:bg-sandstone"
    >
      <DownloadSimple size={20} weight="bold" aria-hidden="true" />
      Descargar imagen
    </a>
  </div>

  <AiLabel class="mt-5" />

  <dialog
    data-dialogo
    aria-label={`Infografía ampliada: ${pieza.titulo}`}
    class="m-auto max-h-[94dvh] w-[min(96vw,64rem)] overflow-auto rounded-card bg-pure-white p-4 text-ink-black backdrop:bg-ink-black/70 md:p-6"
  >
    <div class="flex justify-end">
      <button
        type="button"
        data-cerrar
        class="inline-flex min-h-11 items-center gap-2 rounded-pill border-2 border-ink-black bg-pure-white px-4 text-body-sm font-medium hover:bg-sandstone"
      >
        <X size={18} weight="bold" aria-hidden="true" />
        Cerrar
      </button>
    </div>
    <img
      src={grande.src}
      alt={pieza.alt}
      width={grande.attributes.width}
      height={grande.attributes.height}
      loading="lazy"
      decoding="async"
      class="mx-auto mt-3 block h-auto max-w-full rounded-soft"
      style={`background:${pieza.fondo}`}
    />
  </dialog>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-infografia]').forEach((bloque) => {
    const dialogo = bloque.querySelector<HTMLDialogElement>('[data-dialogo]');
    const abrir = bloque.querySelector<HTMLButtonElement>('[data-abrir]');
    const cerrar = bloque.querySelector<HTMLButtonElement>('[data-cerrar]');
    if (!dialogo || !abrir || !cerrar || typeof dialogo.showModal !== 'function') return;
    abrir.addEventListener('click', () => dialogo.showModal());
    cerrar.addEventListener('click', () => dialogo.close());
    // click on the backdrop closes the dialog; Escape is handled natively
    dialogo.addEventListener('click', (e) => {
      if (e.target === dialogo) dialogo.close();
    });
    dialogo.addEventListener('close', () => abrir.focus());
  });
</script>
