---
// path with one station per text type: a vertical dotted line that joins three cards.
// It reads the same with or without scripts.
import Libro from '../ilustraciones/libro.astro';
import Periodico from '../ilustraciones/periodico.astro';
import ListaPasos from '../ilustraciones/lista_pasos.astro';

interface Estacion {
  id: string;
  titulo: string;
  mision: string;
  partes: string[][];
  pistas: string;
}
interface Props {
  estaciones: Estacion[];
}
const { estaciones } = Astro.props;
const arte = [Libro, Periodico, ListaPasos];
const colores = ['bg-coral-pop', 'bg-sunshine-pop', 'bg-fresh-grass'];
---

<ol class="sendero relative flex flex-col gap-6">
  {estaciones.map((e, i) => {
    const Arte = arte[i % arte.length];
    return (
      <li
        id={e.id}
        class="relative grid scroll-mt-28 grid-cols-[3.25rem_1fr] gap-3 md:grid-cols-[5rem_1fr] md:gap-5"
      >
        <div class="relative flex justify-center" aria-hidden="true">
          <span
            class:list={[
              'relative z-10 flex size-12 items-center justify-center rounded-full border-2 border-ink-black md:size-16',
              colores[i % colores.length],
            ]}
          >
            <Arte size={36} />
          </span>
        </div>
        <div class="rounded-card border-2 border-ink-black bg-pure-white p-5 text-ink-black md:p-7">
          <p class="interfaz text-body-sm font-medium text-stone-text">Estación {i + 1}</p>
          <h4 class="mt-1 text-heading-sm leading-tight">{e.titulo}</h4>
          <p class="mt-3 text-body font-bold">Misión: {e.mision}</p>
          <p class="interfaz mt-4 text-body-sm font-medium text-stone-text">Partes</p>
          <ul class="mt-1 space-y-1 text-body">
            {e.partes.map(([nombre, detalle]) => (
              <li>
                <span class="font-bold">{nombre}</span>
                {detalle ? `: ${detalle}` : ''}
              </li>
            ))}
          </ul>
          <p class="interfaz mt-4 text-body-sm font-medium text-stone-text">
            Pistas para reconocerlo
          </p>
          <p class="mt-1 text-body">{e.pistas}</p>
        </div>
      </li>
    );
  })}
</ol>

<style>
  /* the dotted line runs behind the numbered discs, from the first to the last */
  .sendero::before {
    content: '';
    position: absolute;
    top: 2rem;
    bottom: 2rem;
    left: 1.625rem;
    border-left: 6px dotted var(--color-stone-gray);
  }
  @media (min-width: 768px) {
    .sendero::before {
      left: 2.5rem;
      margin-left: -3px;
    }
  }
</style>
