---
import PortadaCapitulo from '../../libro/portada_capitulo.astro';
import Sofia from '../sofia.astro';
import Mateo from '../mateo.astro';
import Celular from '../celular.astro';

interface Props {
  titulo: string;
  alt: string;
}
const { titulo, alt } = Astro.props;
---

<PortadaCapitulo numero={4} titulo={titulo} color="coral-pop" alt={alt}>
  <svg
    slot="fondo"
    viewBox="0 0 800 800"
    class="h-full w-full"
    preserveAspectRatio="xMidYMid meet"
    focusable="false"
  >
    <g transform="rotate(-7 400 380)">
      <!-- Sombra de la "pantalla" o "hoja" -->
      <rect x="115" y="95" width="560" height="620" rx="34" fill="#2c2e2a" opacity="0.1"></rect>
      <!-- Base oscura atrás -->
      <rect x="110" y="90" width="560" height="620" rx="34" fill="#e0dbce"></rect>
      <!-- Pantalla principal -->
      <rect x="90" y="110" width="560" height="620" rx="34" fill="#ffffff"></rect>
      
      <!-- Top bar (Navegador/App) -->
      <rect x="130" y="150" width="480" height="70" rx="16" fill="#2c2e2a"></rect>
      <!-- Botones de ventana de app -->
      <circle cx="160" cy="185" r="8" fill="#ff705d"></circle>
      <circle cx="185" cy="185" r="8" fill="#f5e211"></circle>
      <circle cx="210" cy="185" r="8" fill="#8ed462"></circle>
      <!-- Buscador / Título en la barra -->
      <rect x="250" y="175" width="200" height="20" rx="10" fill="#4a4c48"></rect>

      <!-- Imagen/Bloque destacado -->
      <rect x="130" y="250" width="200" height="150" rx="16" fill="#2ba0ff"></rect>
      <!-- Detalles visuales en el bloque azul (paisaje simple) -->
      <circle cx="270" cy="290" r="20" fill="#ffffff" opacity="0.4"></circle>
      <path d="M 130 360 Q 180 320 230 360 T 330 370 V 400 H 130 Z" fill="#ffffff" opacity="0.2"></path>

      <!-- Líneas de texto -->
      <g stroke="#d5d5d4" stroke-width="16" stroke-linecap="round">
        <path d="M370 268 H610 M370 316 H610 M370 364 H560"></path>
        <path d="M130 440 H610 M130 488 H590 M130 536 H520 M130 584 H610 M130 632 H470"></path>
      </g>
      <!-- Highlights en las líneas -->
      <g stroke="#f5f1e4" stroke-width="8" stroke-linecap="round">
        <path d="M370 268 H450 M130 440 H250 M130 536 H200"></path>
      </g>
    </g>
  </svg>
  <svg
    slot="medio"
    viewBox="0 0 800 800"
    class="h-full w-full"
    preserveAspectRatio="xMidYMid meet"
    focusable="false"
  >
    <!-- Burbuja Check -->
    <g transform="translate(600 150)">
      <circle cx="3" cy="5" r="58" fill="#2c2e2a" opacity="0.15"></circle>
      <!-- Cola de la burbuja -->
      <path d="M -30 40 L -50 70 L -10 55 Z" fill="#8ed462" stroke="#2c2e2a" stroke-width="7" stroke-linejoin="round"></path>
      <circle cx="0" cy="0" r="58" fill="#8ed462" stroke="#2c2e2a" stroke-width="7"></circle>
      <path d="M -30 40 L -50 70 L -10 55" fill="#8ed462"></path>
      <!-- Check mark -->
      <path
        d="M-26 2 L-8 22 L28 -18"
        stroke="#2c2e2a"
        stroke-width="12"
        stroke-linecap="round"
        stroke-linejoin="round"
        fill="none"
      ></path>
      <!-- Brillo -->
      <path d="M-40 -20 A 46 46 0 0 1 0 -46" stroke="#a9e388" stroke-width="6" stroke-linecap="round" fill="none"></path>
    </g>
    
    <!-- Burbuja Interrogación 1 -->
    <g transform="translate(160 330)">
      <circle cx="3" cy="5" r="52" fill="#2c2e2a" opacity="0.15"></circle>
      <!-- Cola -->
      <path d="M 20 40 L 40 70 L 40 45 Z" fill="#ffffff" stroke="#2c2e2a" stroke-width="7" stroke-linejoin="round"></path>
      <circle cx="0" cy="0" r="52" fill="#ffffff" stroke="#2c2e2a" stroke-width="7"></circle>
      <path d="M 20 40 L 40 70 L 40 45" fill="#ffffff"></path>
      
      <text x="0" y="26" text-anchor="middle" font-size="76" font-weight="500" fill="#2c2e2a">
        ?
      </text>
    </g>

    <!-- Burbuja Interrogación 2 -->
    <g transform="translate(540 540)">
      <circle cx="3" cy="5" r="46" fill="#2c2e2a" opacity="0.15"></circle>
      <!-- Cola -->
      <path d="M 20 30 L 45 50 L 35 25 Z" fill="#f5e211" stroke="#2c2e2a" stroke-width="7" stroke-linejoin="round"></path>
      <circle cx="0" cy="0" r="46" fill="#f5e211" stroke="#2c2e2a" stroke-width="7"></circle>
      <path d="M 20 30 L 45 50 L 35 25" fill="#f5e211"></path>
      
      <text x="0" y="22" text-anchor="middle" font-size="64" font-weight="500" fill="#2c2e2a">
        ?
      </text>
      <!-- Brillo -->
      <path d="M-30 -15 A 36 36 0 0 1 0 -36" stroke="#ffffff" stroke-width="4" stroke-linecap="round" fill="none" opacity="0.6"></path>
    </g>
  </svg>
  <svg
    slot="frente"
    viewBox="0 0 800 800"
    class="h-full w-full"
    preserveAspectRatio="xMidYMid meet"
    focusable="false"
  >
    <g transform="translate(590 380)">
      <Celular size={250} />
    </g>
    <g transform="translate(60 470)">
      <Sofia size={310} pose="lupa" />
    </g>
    <g transform="translate(330 490)">
      <Mateo size={290} pose="libreta" />
    </g>
  </svg>
</PortadaCapitulo>
