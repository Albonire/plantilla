---
// phone showing message bubbles
interface Props {
  size?: number;
  class?: string;
}
const { size = 100, class: clase = '' } = Astro.props;
---

<svg
  viewBox="0 0 64 104"
  height={size}
  width={(size * 64) / 104}
  class={clase}
  aria-hidden="true"
  focusable="false"
>
  <!-- Sombra del celular -->
  <rect x="7" y="7" width="56" height="96" rx="10" fill="rgba(0,0,0,0.1)"></rect>
  
  <!-- Cuerpo del celular -->
  <rect x="4" y="4" width="56" height="96" rx="10" fill="#2c2e2a" stroke="#1f201d" stroke-width="1"></rect>
  <rect x="6" y="6" width="52" height="92" rx="8" fill="#4b4e47"></rect>
  
  <!-- Pantalla -->
  <rect x="9" y="14" width="46" height="76" rx="4" fill="#ffffff"></rect>
  <rect x="9" y="14" width="46" height="76" rx="4" fill="rgba(43,160,255,0.05)"></rect>
  
  <!-- Brillo de la pantalla -->
  <path d="M 9 14 L 55 14 L 55 34 L 9 54 Z" fill="rgba(255,255,255,0.4)" opacity="0.5"></path>
  
  <!-- Notch/Cámara -->
  <rect x="26" y="8" width="12" height="4" rx="2" fill="#2c2e2a"></rect>
  <circle cx="22" cy="10" r="1.5" fill="#1f201d"></circle>

  <!-- Burbuja 1 -->
  <rect x="14" y="24" width="30" height="14" rx="5" fill="#2ba0ff"></rect>
  <!-- Sombra interna/detalle burbuja 1 -->
  <path d="M 14 33 L 44 33 A 5 5 0 0 0 44 38 L 19 38 A 5 5 0 0 1 14 33 Z" fill="rgba(0,0,0,0.1)"></path>
  <path d="M 14 29 L 14 33 L 10 35 L 14 32 Z" fill="#2ba0ff"></path>

  <!-- Burbuja 2 -->
  <rect x="20" y="44" width="30" height="14" rx="5" fill="#f5e211"></rect>
  <!-- Sombra interna/detalle burbuja 2 -->
  <path d="M 20 53 L 50 53 A 5 5 0 0 0 50 58 L 25 58 A 5 5 0 0 1 20 53 Z" fill="rgba(0,0,0,0.1)"></path>
  <path d="M 50 49 L 50 53 L 54 55 L 50 52 Z" fill="#f5e211"></path>

  <!-- Burbuja 3 -->
  <rect x="14" y="64" width="26" height="14" rx="5" fill="#ff705d"></rect>
  <path d="M 14 73 L 40 73 A 5 5 0 0 0 40 78 L 19 78 A 5 5 0 0 1 14 73 Z" fill="rgba(0,0,0,0.1)"></path>
  <path d="M 14 69 L 14 73 L 10 75 L 14 72 Z" fill="#ff705d"></path>

  <!-- Botón central (Home) -->
  <circle cx="32" cy="95" r="3" fill="#2c2e2a"></circle>
  <circle cx="32" cy="95" r="2" fill="#5f615e"></circle>
</svg>
