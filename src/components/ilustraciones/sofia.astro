---
// Sofía: 10 years old, ponytail, yellow jacket, navy pants, big lupa with green handle
interface Props {
  size?: number;
  pose?: 'lupa' | 'senala' | 'cadera';
  class?: string;
}
const { size = 220, pose = 'lupa', class: clase = '' } = Astro.props;
const PIEL = '#dcae82';
const CHAQUETA = '#f5e211';
const TINTA = '#2c2e2a';
---

<svg
  viewBox="-14 0 184 232"
  height={size}
  width={(size * 184) / 232}
  class={clase}
  aria-hidden="true"
  focusable="false"
>
  <!-- ponytail behind the head -->
  <path d="M112 44 C150 36 158 90 128 112 C136 86 128 66 108 58 Z" fill={TINTA}></path>
  <circle cx="114" cy="50" r="6" fill="#ff705d"></circle>
  <!-- legs and shoes -->
  <path d="M60 168 Q64 194 60 220 L80 220 Q76 194 80 168 Z" fill="#2f4a6b"/>
<path d="M62 168 Q66 194 62 220 L70 220 Q68 194 70 168 Z" fill="#20344d"/>
  <path d="M84 168 Q88 194 84 220 L104 220 Q100 194 104 168 Z" fill="#2f4a6b"/>
<path d="M86 168 Q90 194 86 220 L94 220 Q92 194 94 168 Z" fill="#20344d"/>
  <ellipse cx="68" cy="224" rx="16" ry="7" fill={TINTA}></ellipse>
  <ellipse cx="98" cy="224" rx="16" ry="7" fill={TINTA}></ellipse>
  <!-- torso -->
  <path d="M46 106 Q82 94 118 106 L126 178 Q82 192 38 178 Z" fill={CHAQUETA}/>
<path d="M42 170 Q82 184 122 170 L126 178 Q82 192 38 178 Z" fill="#d6c800"/>
  <path d="M82 112 L82 182" stroke="#d6c800" stroke-width="2.5"></path>
  <path d="M66 104 L82 126 L98 104 Z" fill="#ffffff"></path>
  <rect x="74" y="92" width="16" height="16" fill={PIEL}></rect>

  {pose === 'cadera' ? (
    <>
      <path
        d="M50 116 Q30 138 54 156"
        stroke={CHAQUETA}
        stroke-width="16"
        stroke-linecap="round"
        fill="none"
      ></path>
      <path
        d="M114 116 Q134 138 110 156"
        stroke={CHAQUETA}
        stroke-width="16"
        stroke-linecap="round"
        fill="none"
      ></path>
      <circle cx="55" cy="157" r="8" fill={PIEL}></circle>
      <circle cx="109" cy="157" r="8" fill={PIEL}></circle>
    </>
  ) : (
    <>
      <!-- left arm raises the lupa -->
      <path
        d="M50 116 Q28 130 32 102"
        stroke={CHAQUETA}
        stroke-width="16"
        stroke-linecap="round"
        fill="none"
      ></path>
      <path d="M32 98 L22 66" stroke="#8ed462" stroke-width="8" stroke-linecap="round"></path>
      <circle cx="32" cy="98" r="8.5" fill={PIEL}></circle>
      <circle cx="16" cy="46" r="19" fill="#dbeefb" stroke={TINTA} stroke-width="5.5"></circle>
      <path
        d="M7 42 A11 11 0 0 1 15 34"
        stroke="#ffffff"
        stroke-width="3.5"
        stroke-linecap="round"
        fill="none"
      ></path>
      {pose === 'senala' ? (
        <>
          <path
            d="M114 116 Q144 112 154 96"
            stroke={CHAQUETA}
            stroke-width="16"
            stroke-linecap="round"
            fill="none"
          ></path>
          <circle cx="156" cy="93" r="8.5" fill={PIEL}></circle>
          <path d="M160 88 L168 80" stroke={PIEL} stroke-width="5" stroke-linecap="round"></path>
        </>
      ) : (
        <>
          <path
            d="M114 116 Q134 140 126 162"
            stroke={CHAQUETA}
            stroke-width="16"
            stroke-linecap="round"
            fill="none"
          ></path>
          <circle cx="125" cy="164" r="8.5" fill={PIEL}></circle>
        </>
      )}
    </>
  )}

  <!-- head -->
  <path d="M50 62 C50 35 114 35 114 62 C114 85 96 95 82 95 C68 95 50 85 50 62 Z" fill={PIEL}/>
<path d="M50 62 C50 35 114 35 114 62 C114 85 96 95 82 95 C68 95 50 85 50 62 Z" fill="#c99a6f" transform="scale(0.95) translate(4 4)" opacity="0.5"/>
  <path
    d="M50 62 C46 24 118 20 114 62 C106 44 92 40 82 40 C68 40 56 46 50 62 Z"
    fill={TINTA}
  ></path>
  <path d="M52 60 C62 46 84 44 100 46 C86 50 68 54 52 60 Z" fill={TINTA}></path>
  <circle cx="70" cy="68" r="3.6" fill={TINTA}></circle>
  <circle cx="94" cy="68" r="3.6" fill={TINTA}></circle>
  <circle cx="61" cy="79" r="6" fill="#ff705d" opacity="0.4"></circle>
  <circle cx="103" cy="79" r="6" fill="#ff705d" opacity="0.4"></circle>
  <path
    d="M74 82 Q82 90 90 82"
    stroke={TINTA}
    stroke-width="2.6"
    stroke-linecap="round"
    fill="none"
  ></path>
</svg>
