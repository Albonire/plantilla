---
// six-panel comic strip, 3 columns by 2 rows. Each panel is 480 x 360 units.
import Sofia from './sofia.astro';
import Mateo from './mateo.astro';
import Burbuja from './burbuja.astro';
import Libro from './libro.astro';
import Periodico from './periodico.astro';
import ListaPasos from './lista_pasos.astro';
import Renacuajo from './renacuajo.astro';

const W = 480;
const H = 360;
const fondos = ['#cfe6f7', '#fde0da', '#e6f4d4', '#fbf4bd', '#d9ecfa', '#f5f1e4'];
const paneles = Array.from({ length: 6 }, (_, i) => ({
  x: (i % 3) * W,
  y: Math.floor(i / 3) * H,
  fondo: fondos[i],
}));
---

<svg
  viewBox={`0 0 ${W * 3} ${H * 2}`}
  class="block h-full w-full"
  focusable="false"
  role="img"
  aria-label="Cómic de seis viñetas: Sofía y Mateo descubren un texto narrativo, uno informativo y uno instructivo."
>
  <rect width={W * 3} height={H * 2} fill="#2c2e2a"></rect>
  {paneles.map((p) => (
    <rect x={p.x + 8} y={p.y + 8} width={W - 16} height={H - 16} rx="26" fill={p.fondo}></rect>
  ))}

  <!-- panel 1: the box with three sheets -->
  <svg x="0" y="0" width={W} height={H} viewBox={`0 0 ${W} ${H}`}>
    <!-- Box Shadow -->
    <rect x="154" y="252" width="180" height="82" rx="8" fill="#a88554"></rect>
    <!-- Box body -->
    <rect x="150" y="248" width="180" height="82" rx="8" fill="#c9a26b" stroke="#2c2e2a" stroke-width="4"></rect>
    <!-- Box inside back edge -->
    <rect x="154" y="248" width="172" height="12" fill="#b58c52"></rect>
    
    <!-- Sheets with paper texture and depth -->
    <g stroke="#2c2e2a" stroke-width="3">
      <!-- Left sheet -->
      <g transform="rotate(-8 202 224)">
        <rect x="178" y="190" width="52" height="70" rx="5" fill="#d0ccc0"></rect> <!-- shadow -->
        <rect x="176" y="188" width="52" height="70" rx="5" fill="#ffffff"></rect>
        <line x1="182" y1="198" x2="222" y2="198" stroke="#d5d5d4" stroke-width="2" stroke-linecap="round"></line>
        <line x1="182" y1="208" x2="216" y2="208" stroke="#d5d5d4" stroke-width="2" stroke-linecap="round"></line>
      </g>
      <!-- Right sheet -->
      <g transform="rotate(8 278 224)">
        <rect x="254" y="190" width="52" height="70" rx="5" fill="#d0ccc0"></rect> <!-- shadow -->
        <rect x="252" y="188" width="52" height="70" rx="5" fill="#ffffff"></rect>
        <line x1="258" y1="198" x2="298" y2="198" stroke="#d5d5d4" stroke-width="2" stroke-linecap="round"></line>
        <line x1="258" y1="208" x2="288" y2="208" stroke="#d5d5d4" stroke-width="2" stroke-linecap="round"></line>
      </g>
      <!-- Center sheet -->
      <g>
        <rect x="216" y="178" width="52" height="82" rx="5" fill="#d0ccc0"></rect> <!-- shadow -->
        <rect x="214" y="176" width="52" height="82" rx="5" fill="#ffffff"></rect>
        <line x1="220" y1="186" x2="260" y2="186" stroke="#d5d5d4" stroke-width="2" stroke-linecap="round"></line>
        <line x1="220" y1="196" x2="254" y2="196" stroke="#d5d5d4" stroke-width="2" stroke-linecap="round"></line>
        <line x1="220" y1="206" x2="260" y2="206" stroke="#d5d5d4" stroke-width="2" stroke-linecap="round"></line>
      </g>
    </g>
    
    <!-- Box front flap overlay -->
    <path d="M150 256 L330 256 L330 330 C330 334 326 338 322 338 L158 338 C154 338 150 334 150 330 Z" fill="#c9a26b" stroke="#2c2e2a" stroke-width="4" stroke-linejoin="round"></path>
    <!-- Box flap lines -->
    <line x1="160" y1="264" x2="160" y2="320" stroke="#a88554" stroke-width="2" stroke-linecap="round"></line>
    <line x1="320" y1="264" x2="320" y2="320" stroke="#a88554" stroke-width="2" stroke-linecap="round"></line>

    <g transform="translate(22 128)">
      <Mateo size={214} pose="libreta" />
    </g>
    <g transform="translate(298 128)">
      <Sofia size={214} pose="lupa" />
    </g>
    <Burbuja
      x={24}
      y={28}
      ancho={206}
      tamano={14}
      texto="¡Tres textos misteriosos! ¿Cómo sabemos qué es cada uno?"
      cola_x={0.3}
    />
    <Burbuja
      x={256}
      y={28}
      ancho={206}
      tamano={14}
      texto="Un detective se pregunta para qué sirve el texto."
      cola_x={0.7}
    />
  </svg>

  <!-- panel 2: narrative -->
  <svg x={W} y="0" width={W} height={H} viewBox={`0 0 ${W} ${H}`}>
    <g transform="translate(40 60) rotate(-4 90 110)">
      <!-- Sheet shadow -->
      <rect width="190" height="240" rx="10" transform="translate(4 4)" fill="#d0ccc0"></rect>
      <!-- Sheet -->
      <rect
        width="190"
        height="240"
        rx="10"
        fill="#ffffff"
        stroke="#2c2e2a"
        stroke-width="4"
      ></rect>
      
      <!-- Decorative header -->
      <path d="M10 44 L180 44" stroke="#e0dbce" stroke-width="3" stroke-linecap="round"></path>
      
      <text x="16" y="34" font-size="15" font-weight="600" fill="#8b8e88">
        Hoja 1
      </text>
      <text x="16" y="66" font-size="18" font-weight="600" fill="#2c2e2a">
        Había una vez
      </text>
      <text x="16" y="88" font-size="18" font-weight="600" fill="#2c2e2a">
        un renacuajo...
      </text>
      
      <!-- Renacuajo illustration framing -->
      <rect x="38" y="104" width="118" height="118" rx="59" fill="#e6f4d4" stroke="#8ed462" stroke-width="2" stroke-dasharray="4 4"></rect>
      <g transform="translate(38 104)">
        <Renacuajo size={118} />
      </g>
      <!-- Text lines placeholder -->
      <g stroke="#d5d5d4" stroke-width="4" stroke-linecap="round">
         <line x1="16" y1="228" x2="174" y2="228"></line>
      </g>
    </g>
    <g transform="translate(292 130)">
      <Sofia size={224} pose="senala" />
    </g>
    <Burbuja
      x={218}
      y={22}
      ancho={236}
      tamano={13.5}
      texto="Este cuenta una historia con personajes. Es un texto narrativo y tiene inicio, nudo y desenlace."
      cola_x={0.75}
    />
  </svg>

  <!-- panel 3: informative -->
  <svg x={W * 2} y="0" width={W} height={H} viewBox={`0 0 ${W} ${H}`}>
    <g transform="translate(250 60) rotate(4 90 110)">
      <!-- Sheet Shadow -->
      <rect width="190" height="240" rx="10" transform="translate(4 4)" fill="#d0ccc0"></rect>
      <!-- Sheet -->
      <rect
        width="190"
        height="240"
        rx="10"
        fill="#ffffff"
        stroke="#2c2e2a"
        stroke-width="4"
      ></rect>

      <!-- Decorative header -->
      <path d="M10 44 L180 44" stroke="#e0dbce" stroke-width="3" stroke-linecap="round"></path>

      <text x="16" y="34" font-size="15" font-weight="600" fill="#8b8e88">
        Hoja 2
      </text>
      <text x="16" y="66" font-size="16" font-weight="600" fill="#2c2e2a">
        Rafael Pombo nació
      </text>
      <text x="16" y="87" font-size="16" font-weight="600" fill="#2c2e2a">
        en Bogotá en 1833...
      </text>
      
      <!-- Portrait box -->
      <rect x="18" y="114" width="62" height="60" rx="8" fill="#d25a48"></rect>
      <rect x="16" y="112" width="62" height="60" rx="8" fill="#ff705d" stroke="#2c2e2a" stroke-width="3"></rect>
      <circle cx="47" cy="132" r="12" fill="#ffffff"></circle>
      <path d="M26 172 C26 150 68 150 68 172" fill="#ffffff"></path>
      
      <text x="47" y="196" text-anchor="middle" font-size="18" font-weight="600" fill="#2c2e2a">
        1833
      </text>

      <g stroke="#d5d5d4" stroke-width="7" stroke-linecap="round">
        <path d="M92 122 H172 M92 142 H172 M92 162 H150 M16 214 H172 M16 228 H140"></path>
      </g>
    </g>
    <g transform="translate(26 130)">
      <Mateo size={224} pose="libreta" />
    </g>
    <Burbuja
      x={30}
      y={22}
      ancho={226}
      tamano={13.5}
      texto="Este da datos reales. Es un texto informativo: quiere que aprendamos algo."
      cola_x={0.3}
    />
  </svg>

  <!-- panel 4: instructive -->
  <svg x="0" y={H} width={W} height={H} viewBox={`0 0 ${W} ${H}`}>
    <g transform="translate(40 58) rotate(-3 90 110)">
      <!-- Sheet shadow -->
      <rect width="190" height="244" rx="10" transform="translate(4 4)" fill="#d0ccc0"></rect>
      <!-- Sheet -->
      <rect
        width="190"
        height="244"
        rx="10"
        fill="#ffffff"
        stroke="#2c2e2a"
        stroke-width="4"
      ></rect>
      
      <!-- Decorative header -->
      <path d="M10 44 L180 44" stroke="#e0dbce" stroke-width="3" stroke-linecap="round"></path>

      <text x="16" y="34" font-size="15" font-weight="600" fill="#8b8e88">
        Hoja 3
      </text>
      
      <!-- Bullets for materials -->
      <circle cx="20" cy="59" r="4" fill="#2ba0ff"></circle>
      <text x="32" y="64" font-size="17" font-weight="600" fill="#2c2e2a">
        Materiales...
      </text>
      
      <circle cx="20" cy="87" r="4" fill="#8ed462"></circle>
      <text x="32" y="92" font-size="17" font-weight="600" fill="#2c2e2a">
        Paso 1...
      </text>
      
      <circle cx="20" cy="115" r="4" fill="#ff705d"></circle>
      <text x="32" y="120" font-size="17" font-weight="600" fill="#2c2e2a">
        Paso 2...
      </text>
      <g transform="translate(86 132)">
        <ListaPasos size={98} />
      </g>
    </g>
    <g transform="translate(292 130)">
      <Sofia size={224} pose="lupa" />
    </g>
    <Burbuja
      x={222}
      y={22}
      ancho={234}
      tamano={13.5}
      texto="Este dice cómo hacer algo en orden. Es un texto instructivo."
      cola_x={0.75}
    />
  </svg>

  <!-- panel 5: mixed steps -->
  <svg x={W} y={H} width={W} height={H} viewBox={`0 0 ${W} ${H}`}>
    <g stroke="#2c2e2a" stroke-width="4">
      <!-- Step 3 Card -->
      <g transform="rotate(-14 182 260)">
        <rect x="153" y="241" width="64" height="44" rx="6" fill="#d0ccc0" stroke="none"></rect>
        <rect x="150" y="238" width="64" height="44" rx="6" fill="#ffffff"></rect>
        <line x1="156" y1="246" x2="208" y2="246" stroke="#d5d5d4" stroke-width="2" stroke-linecap="round"></line>
        <text x="164" y="266" font-size="16" font-weight="600" fill="#2c2e2a" stroke="none">Paso 3</text>
      </g>
      
      <!-- Step 1 Card -->
      <g transform="rotate(10 258 284)">
        <rect x="229" y="265" width="64" height="44" rx="6" fill="#d0ccc0" stroke="none"></rect>
        <rect x="226" y="262" width="64" height="44" rx="6" fill="#ffffff"></rect>
        <line x1="232" y1="270" x2="284" y2="270" stroke="#d5d5d4" stroke-width="2" stroke-linecap="round"></line>
        <text x="240" y="290" font-size="16" font-weight="600" fill="#2c2e2a" stroke="none">Paso 1</text>
      </g>

      <!-- Step 2 Card -->
      <g transform="rotate(-4 214 314)">
        <rect x="185" y="295" width="64" height="44" rx="6" fill="#d0ccc0" stroke="none"></rect>
        <rect x="182" y="292" width="64" height="44" rx="6" fill="#ffffff"></rect>
        <line x1="188" y1="300" x2="240" y2="300" stroke="#d5d5d4" stroke-width="2" stroke-linecap="round"></line>
        <text x="196" y="320" font-size="16" font-weight="600" fill="#2c2e2a" stroke="none">Paso 2</text>
      </g>
    </g>
    
    <g transform="translate(20 128)">
      <Mateo size={214} pose="levanta" />
    </g>
    <g transform="translate(300 128)">
      <Sofia size={214} pose="cadera" />
    </g>
    <Burbuja x={16} y={24} ancho={168} tamano={14} texto="¿Y si mezclo los pasos?" cola_x={0.35} />
    <Burbuja
      x={214}
      y={24}
      ancho={250}
      tamano={13.5}
      texto="¡El separador te quedaría mal! En un instructivo el orden importa."
      cola_x={0.8}
    />
  </svg>

  <!-- panel 6: the clue of the day -->
  <svg x={W * 2} y={H} width={W} height={H} viewBox={`0 0 ${W} ${H}`}>
    <!-- Glow behind the clue items -->
    <ellipse cx="240" cy="140" rx="180" ry="60" fill="#fcf6c5" opacity="0.6"></ellipse>
    
    <g transform="translate(60 110)">
      <Libro size={62} />
    </g>
    <g transform="translate(206 104)">
      <Periodico size={66} />
    </g>
    <g transform="translate(356 106)">
      <ListaPasos size={66} />
    </g>
    
    <g transform="translate(70 138)">
      <Mateo size={214} pose="libreta" />
    </g>
    <g transform="translate(258 138)">
      <Sofia size={214} pose="lupa" />
    </g>
    <Burbuja
      x={26}
      y={22}
      ancho={428}
      tamano={14.5}
      texto="Pista del día: pregúntate si el texto te cuenta, te informa o te enseña a hacer algo."
      cola_x={0.5}
      fondo="#f5e211"
    />
  </svg>

  <!-- panel frames -->
  <g fill="none" stroke="#2c2e2a" stroke-width="8">
    {paneles.map((p) => (
      <rect x={p.x + 8} y={p.y + 8} width={W - 16} height={H - 16} rx="26"></rect>
    ))}
  </g>
</svg>
